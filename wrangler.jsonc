{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stumble",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["enable_ctx_exports"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPERVISOR",
        "class_name": "Supervisor",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Supervisor"],
    },
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    {
      "binding": "MODULE_MAPS",
      "bucket_name": "cf-stumble-module-maps",
    },
  ],
}
