{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stumble-test",
  "main": "src/worker.ts",
  "build": { "command": "pnpm run build:page" },
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["enable_ctx_exports", "nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true },
    "issues": { "enabled": true },
  },
  "routes": [{ "pattern": "stumble.akompella.dev/*", "zone_name": "akompella.dev" }],
  "workers_dev": false,
  "cache": { "enabled": false },
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPERVISOR",
        "class_name": "Supervisor",
      },
      {
        "name": "WORKSPACE_HOST",
        "class_name": "WorkspaceHost",
      },
    ],
  },
  "exports": {
    "Supervisor": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceHost": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "cf-stumble-workspacehost",
    },
  },
  "containers": [
    {
      "name": "cf-stumble-workspacehost",
      "image": "./containers/computerd.Dockerfile",
      "image_build_context": ".",
      "max_instances": 1,
      "instance_type": "standard-3",
    },
  ],
  "vars": { "CHATGPT_MODEL": "gpt-6.1-sol" },
  "worker_loaders": [{ "binding": "LOADER" }],
}
