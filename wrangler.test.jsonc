// Generated view of wrangler.jsonc without the AI binding.
// Declaring Workers AI opens a remote connection for every Workers test, so one network
// failure can fail unrelated tests. test/docs/test-config.test.ts proves this is the only
// difference.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-stumble-test",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  // @cloudflare/computer imports node:crypto and node:events, so the Worker does not start
  // without nodejs_compat. Vitest resolves those itself, which is why the suite passed while
  // `wrangler dev` failed to boot.
  "compatibility_flags": ["enable_ctx_exports", "nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SUPERVISOR",
        "class_name": "Supervisor",
      },
      {
        "name": "WORKSPACE_HOST",
        "class_name": "WorkspaceHost",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Supervisor"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["WorkspaceHost"],
    },
  ],
  "containers": [
    {
      "class_name": "WorkspaceHost",
      "image": "./containers/computerd.Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  "r2_buckets": [
    {
      "binding": "MODULE_MAPS",
      "bucket_name": "cf-stumble-module-maps",
    },
  ],
}
