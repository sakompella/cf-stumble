#!/bin/sh

if ! command -v nix >/dev/null 2>&1; then
  echo "pre-commit: nix is not on PATH, so the verify gate cannot run. Install Nix with flakes enabled." >&2
  exit 1
fi

unset $(git rev-parse --local-env-vars)

printf 'pre-commit: verifying... '

if output=$(nix develop -c pnpm verify 2>&1); then
  echo "ok"
  exit 0
fi

echo "FAILED"
printf '%s\n' "$output" >&2
exit 1
