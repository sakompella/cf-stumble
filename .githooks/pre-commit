#!/bin/sh

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm is not on PATH, so pnpm verify cannot run. Install pnpm or fix PATH." >&2
  exit 1
fi

# Git exports GIT_DIR, GIT_INDEX_FILE and friends to hooks. Tests that run git in
# scratch directories inherit them and act on this repository instead: a scratch
# `git init` once set core.bare=true here and a scratch commit landed on the branch.
unset $(git rev-parse --local-env-vars)

printf 'pre-commit: verifying... '

if output=$(pnpm verify 2>&1); then
  echo "ok"
  exit 0
fi

echo "FAILED"
printf '%s\n' "$output" >&2
exit 1
