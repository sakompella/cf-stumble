#!/bin/sh
# Runs the full gate before every commit: build:pi, vendor and protocol checks, typecheck, format, lint, tools tests, module-map and fixture builds, tests (about 90 s on the Mac).
# That order is deliberate. Type errors make the type-aware lint rules report "error type"
# noise instead of the real fault, and formatting changes what lint sees at all — wrapping a
# long line has pushed a file over max-lines here before.
#
# Output is held back and printed only on failure. A successful run prints one line, because
# a hook that dumps forty lines of miniflare warnings on every commit is one people learn to
# bypass. Checks the working tree, not the index, so a partial `git add` can still commit
# while unstaged work is broken. Bypass with `git commit --no-verify`.
#
# jj does not run git hooks. Under `jj commit`, run `pnpm verify` yourself.

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit: pnpm is not on PATH, so pnpm verify cannot run. Install pnpm or fix PATH." >&2
  exit 1
fi

printf 'pre-commit: verifying... '

if output=$(pnpm verify 2>&1); then
  echo "ok"
  exit 0
fi

echo "FAILED"
printf '%s\n' "$output" >&2
exit 1
