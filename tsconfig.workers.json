{
  // Worker-side code. @cloudflare/workers-types is a global augmentation that replaces
  // Node's lib globals, so it cannot share a program with the Node-side code — mixing them
  // makes `crypto` and `TextDecoder` resolve to whichever won, which is how this was
  // discovered. Shared modules under src/git and src/storage are pulled in transitively
  // by imports and so are checked against BOTH environments, which is the point.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "src/supervisor",
    "src/agent",
    "src/storage/do-sqlite.ts",
    "test/facet",
    "test/storage-do",
    "test/supervisor"
  ]
}
