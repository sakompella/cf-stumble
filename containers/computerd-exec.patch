+
+test.each(["stdout", "stderr"] as const)("exec drains paused %s before recording its exit", async (name) => {
+  const { runner, dispose } = fixture();
+  const size = 128 * 1024;
+  const id = `paused-${name}`;
+  try {
+    const handle = runner.exec(`head -c ${size} /dev/zero${name === "stderr" ? " >&2" : ""}`, { id });
+    // The first queued event pauses both pipes. Let the child exit with
+    // unread pipe bytes before the subscriber starts draining them.
+    await new Promise((resolve) => setTimeout(resolve, 100));
+    const events = await drain(handle.events);
+    const bytes = events.reduce((total, event) =>
+      (event.name === "stdout" || event.name === "stderr") && event.name === name
+        ? total + event.value.byteLength : total, 0);
+    expect(bytes).toBe(size);
+    expect(events.at(-1)).toMatchObject({ name: "exit", code: 0 });
+    const replay = await drain(runner.get(id).events);
+    expect(replay).toEqual(events);
+  } finally {
+    dispose();
+  }
+});
+
+
+test("a normal background writer drains before exit", async () => {
+  const { runner, dispose } = fixture();
+  try {
+    const events = await drain(runner.exec("(sleep 0.2; echo late) & echo early").events);
+    const output = events.flatMap((event) => event.name === "stdout" ? [decode(event.value)] : []).join("");
+    expect(output).toBe("early\nlate\n");
+    expect(events.at(-1)).toMatchObject({ name: "exit", code: 0 });
+  } finally { dispose(); }
+});
+
+test("a grandchild holding stdout cannot keep a normal exit open forever", async () => {
+  const { runner, dispose } = fixture();
+  try {
+    const startedAt = Date.now();
+    const events = await drain(runner.exec("sleep 30 & echo hi").events);
+    expect(events.flatMap((event) => event.name === "stdout" ? [decode(event.value)] : []).join("")).toBe("hi\n");
+    expect(events.at(-1)).toMatchObject({ name: "exit", code: 0 });
+    expect(Date.now() - startedAt).toBeLessThan(8_000);
+  } finally { dispose(); }
+});
+
+test("timeout does not wait on a grandchild holding stdout", async () => {
+  const { runner, dispose } = fixture();
+  try {
+    const startedAt = Date.now();
+    const events = await drain(runner.exec("sleep 30 & wait", { timeoutMs: 100 }).events);
+    expect(events.at(-1)).toMatchObject({ name: "exit", code: 143 });
+    expect(Date.now() - startedAt).toBeLessThan(2_000);
+  } finally { dispose(); }
+});
+
+test("a reader that never resumes is closed by the command timeout", async () => {
+  const { runner, db, dispose } = fixture();
+  try {
+    const handle = runner.exec("head -c 131072 /dev/zero", { id: "stalled-reader", timeoutMs: 100 });
+    await new Promise((resolve) => setTimeout(resolve, 300));
+    expect(db.scalar<number>("SELECT exited_at FROM computerd_exec_meta WHERE exec_id = ?", handle.id)).not.toBeNull();
+    const events = await drain(handle.events);
+    expect(events.at(-1)?.name).toBe("exit");
+  } finally { dispose(); }
+});
+
+
+test("kill does not wait on a grandchild holding stdout", async () => {
+  const { runner, dispose } = fixture();
+  try {
+    const handle = runner.exec("sleep 30 & wait", { id: "kill-grandchild" });
+    await new Promise((resolve) => setTimeout(resolve, 50));
+    const startedAt = Date.now();
+    runner.kill(handle.id);
+    const events = await drain(handle.events);
+    expect(events.at(-1)).toMatchObject({ name: "exit", code: 143 });
+    expect(Date.now() - startedAt).toBeLessThan(2_000);
+  } finally { dispose(); }
+});
+
+test("a reader paused beyond the drain grace keeps all normal output", async () => {
+  const { runner, dispose } = fixture();
+  try {
+    const handle = runner.exec("head -c 131072 /dev/zero");
+    await new Promise((resolve) => setTimeout(resolve, 5_300));
+    const events = await drain(handle.events);
+    const bytes = events.reduce((total, event) => event.name === "stdout" ? total + event.value.byteLength : total, 0);
+    expect(bytes).toBe(131072);
+    expect(events.at(-1)).toMatchObject({ name: "exit", code: 0 });
+  } finally { dispose(); }
+});
