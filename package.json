{
  "name": "cf-stumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1",
    "@cloudflare/workers-types": "^5",
    "@oxlint/plugins": "^1",
    "isomorphic-git": "^1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1",
    "oxlint-tsgolint": "^7",
    "typescript": "^7",
    "vitest": "^4",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@11.18.0"
}
