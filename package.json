{
  "name": "cf-stumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "test:tools": "node --import tsx --test 'tools/**/*.test.ts'",
    "test:watch": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p src/page/client && tsrs --noEmit -p src/stumble-cli/orb && tsrs --noEmit -p test/stumble-cli/orb && tsrs --noEmit -p test/page/client && tsrs --noEmit -p infra",
    "typecheck:tools": "tsrs --noEmit -p tools",
    "knip": "knip --production",
    "lint": "oxlint --type-aware --max-warnings=0 --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:artifact": "pnpm install --frozen-lockfile --prod --reporter=silent --ignore-scripts && pnpm run build:module-map",
    "build:module-map": "node tools/build-generation-1.mts",
    "build:page": "pnpm exec tsx tools/build-owner-page.mts",
    "install:infra": "pnpm -C infra install --frozen-lockfile --reporter=silent",
    "alchemy": "infra/node_modules/.bin/alchemy",
    "deploy": "pnpm run install:infra && pnpm run build:page && pnpm alchemy deploy --config infra/alchemy.run.ts --stage prod",
    "build:loaded-execution-env-fixture": "pnpm exec tsx tools/build-loaded-execution-env-fixture.mts",
    "verify:project-protocol": "pnpm exec tsx tools/verify-project-protocol.mts",
    "probe:clean-build": "scripts/probe/clean-build.sh",
    "stumble": "tsx src/stumble-cli/orb/main.ts",
    "ops:check": "pnpm exec tsx tools/ops-check/run.mts --worker cf-stumble --since 2h",
    "test:browser": "pnpm build:page && playwright test -c tools/playwright/playwright.config.mts",
    "verify": "pnpm install:infra && pnpm verify:project-protocol && pnpm build:page && pnpm typecheck && pnpm typecheck:tools && pnpm format:check && pnpm knip && pnpm lint && pnpm test:tools && pnpm build:module-map && pnpm build:loaded-execution-env-fixture && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@cloudflare/computer": "0.8.0",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "effect": "4.1.1",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@effect/platform-browser": "4.1.1",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@hegeldev/hegel": "0.4.12",
    "@oxlint/plugins": "^1.90.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "cf": "1.0.0-beta.26",
    "foldkit": "0.170.0",
    "knip": "6.44.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "4.23.15",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.18.0"
}
