{
  "name": "cf-stumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "test:tools": "node --import tsx --test 'tools/**/*.test.ts'",
    "test:watch": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p src/page/client && tsrs --noEmit -p src/stumble-cli/orb && tsrs --noEmit -p test/stumble-cli/orb && tsrs --noEmit -p test/page/client && tsrs --noEmit -p infra",
    "typecheck:tools": "tsrs --noEmit -p tools",
    "knip": "knip --production",
    "lint": "oxlint --type-aware --max-warnings=0 --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:module-map": "node tools/build-generation-1.mts",
    "build:shell-modules": "pnpm exec tsx tools/build-shell-modules.mts",
    "build:page": "pnpm exec tsx tools/build-owner-page.mts && pnpm exec tsx tools/build-isolate-commands.mts",
    "install:infra": "pnpm -C infra install --frozen-lockfile --reporter=silent",
    "alchemy": "infra/node_modules/.bin/alchemy",
    "deploy": "infra/deploy.sh",
    "build:loaded-execution-env-fixture": "pnpm exec tsx tools/build-loaded-execution-env-fixture.mts",
    "verify:project-protocol": "pnpm exec tsx tools/verify-project-protocol.mts",
    "stumble": "tsx src/stumble-cli/orb/main.ts",
    "ops:check": "pnpm exec tsx tools/ops-check/run.mts --since 2h",
    "e2e": "pnpm exec tsx tools/e2e/run.mts",
    "e2e:fuzz:lifecycle": "pnpm exec tsx tools/e2e/fuzz/lifecycle-run.mts",
    "test:browser": "pnpm build:page && playwright test -c tools/playwright/playwright.config.mts",
    "verify": "pnpm install:infra && pnpm verify:project-protocol && pnpm build:page && pnpm typecheck && pnpm typecheck:tools && pnpm format:check && pnpm knip && pnpm lint && pnpm test:tools && pnpm build:module-map && pnpm build:shell-modules && pnpm build:loaded-execution-env-fixture && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@cloudflare/computer": "0.10.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "effect": "4.1.2",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@effect/platform-browser": "4.1.2",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@hegeldev/hegel": "0.4.12",
    "@oxlint/plugins": "^1.90.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "cf": "1.0.0-beta.27",
    "foldkit": "0.170.0",
    "knip": "6.44.1",
    "miniflare": "5.20261103.0-beta",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "4.23.15",
    "vite": "^8.3.5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.18.0"
}
