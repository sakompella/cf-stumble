{
  "name": "cf-stumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:pi": "pnpm --filter @cf-stumble/pi build",
    "build:module-map": "pnpm exec tsx tools/build-generation-0.mts",
    "build:loaded-execution-env-fixture": "pnpm exec tsx tools/build-loaded-execution-env-fixture.mts",
    "verify:project-protocol": "pnpm exec tsx tools/verify-project-protocol.mts",
    "local:access-session": "pnpm exec tsx tools/access-session.mts",
    "verify:vendor": "pnpm exec tsx tools/vendor-pi.mts --check",
    "verify": "pnpm build:pi && pnpm verify:vendor && pnpm verify:project-protocol && pnpm typecheck && pnpm format:check && pnpm lint && pnpm build:module-map && pnpm build:loaded-execution-env-fixture && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@cloudflare/computer": "file:vendor/cloudflare-computer-0.3.0.tgz",
    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@cf-stumble/pi": "workspace:*",
    "@cloudflare/vitest-plugin": "^1",
    "@cloudflare/workers-types": "^5",
    "@hegeldev/hegel": "0.4.5",
    "@oxlint/plugins": "^1",
    "@types/node": "22.19.19",
    "esbuild": "0.28.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1",
    "oxlint-tsgolint": "^7",
    "tsx": "4.22.1",
    "typebox": "1.3.7",
    "typescript": "^7",
    "vitest": "^4",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@11.18.0"
}
