{
  "name": "cf-stumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "test:tools": "node --import tsx --test 'tools/**/*.test.ts'",
    "test:watch": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest",
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p src/page/client && tsrs --noEmit -p src/stumble-cli/orb && tsrs --noEmit -p test/stumble-cli/orb && tsrs --noEmit -p infra",
    "typecheck:tools": "tsrs --noEmit -p tools",
    "lint:effect": "effect-tsgo tsrs --noEmit && effect-tsgo tsrs --noEmit -p src/page/client && effect-tsgo tsrs --noEmit -p src/stumble-cli/orb && effect-tsgo tsrs --noEmit -p test/stumble-cli/orb && effect-tsgo tsrs --noEmit -p infra && effect-tsgo tsrs --noEmit -p tools",
    "knip": "knip --production",
    "lint": "oxlint --type-aware --max-warnings=0 --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:module-map": "node tools/build-generation-1.mts",
    "build:shell-modules": "pnpm exec tsx tools/build-shell-modules.mts",
    "build:page": "pnpm exec tsx tools/build-owner-page.mts && pnpm exec tsx tools/build-isolate-commands.mts",
    "install:infra": "pnpm -C infra install --frozen-lockfile --reporter=silent",
    "alchemy": "infra/node_modules/.bin/alchemy",
    "deploy": "infra/deploy.sh",
    "build:loaded-execution-env-fixture": "pnpm exec tsx tools/build-loaded-execution-env-fixture.mts",
    "stumble": "tsx src/stumble-cli/orb/main.ts",
    "ops:check": "pnpm exec tsx tools/ops-check/run.mts --since 2h",
    "e2e": "pnpm exec tsx tools/e2e/run.mts",
    "ci:local": "pnpm exec tsx tools/ci-local.mts",
    "verify": "pnpm install:infra && pnpm build:page && pnpm typecheck && pnpm typecheck:tools && pnpm lint:effect && pnpm format:check && pnpm knip && pnpm lint && pnpm test:tools && pnpm build:module-map && pnpm build:shell-modules && pnpm build:loaded-execution-env-fixture && pnpm test"
  },
  "dependencies": {
    "@cloudflare/computer": "0.11.3",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "effect": "4.1.4",
    "esbuild": "0.28.2",
    "just-bash": "3.6.1"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@effect/platform-browser": "4.1.4",
    "@effect/tsgo": "0.70.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@hegeldev/hegel": "0.5.8",
    "@oxlint/plugins": "^1.94.0",
    "@types/node": "22.20.5",
    "cf": "1.0.0-rc.1",
    "foldkit": "0.171.0",
    "knip": "6.45.1",
    "miniflare": "5.20261117.0-beta",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.27.0",
  "knip": {
    "entry": [
      "src/worker.ts!",
      "src/page/client/entry.ts!",
      "src/facet/generation-1/main-facet.ts!",
      "src/stumble-cli/orb/main.ts!",
      "tools/*.mts!",
      "tools/ops-check/run.mts!",
      "tools/e2e/run.mts!",
      "tools/oxlint/cf-stumble/index.ts!",
      "infra/alchemy.run.ts!"
    ],
    "project": [
      "src/**/*.ts!",
      "tools/**/*.{ts,mts}!",
      "infra/**/*.ts!"
    ],
    "include": [
      "files",
      "exports",
      "types",
      "nsExports",
      "nsTypes",
      "duplicates"
    ],
    "ignoreIssues": {
      "tools/oxlint/anti-slop/**": [
        "files",
        "exports",
        "types",
        "nsExports",
        "nsTypes",
        "duplicates"
      ],
      "tools/ops-check/check.mts": [
        "exports"
      ],
      "tools/ops-check/fetch.mts": [
        "exports"
      ],
      "tools/ops-check/telemetry.mts": [
        "exports"
      ],
      "tools/ops-check/versions.mts": [
        "exports",
        "types"
      ],
      "tools/release-generation/release.mts": [
        "exports",
        "types"
      ],
      "src/conversation-view/view-reader.ts": [
        "exports"
      ],
      "src/project-catalog.ts": [
        "exports"
      ],
      "src/selectable-projects.ts": [
        "exports"
      ],
      "src/stumble-cli/orb/tunnel.ts": [
        "exports"
      ],
      "src/workspace/commands/build-harness.ts": [
        "exports"
      ],
      "src/workspace/commands/provision-project.ts": [
        "exports"
      ],
      "src/workspace/commands/remove-project.ts": [
        "exports"
      ],
      "src/workspace/computer-operations.ts": [
        "exports"
      ],
      "src/workspace/managed-instructions.ts": [
        "exports"
      ],
      "src/workspace/project/isolate-egress.ts": [
        "exports"
      ],
      "src/workspace/workspace-platform.ts": [
        "exports"
      ],
      "infra/worker-bundle.ts": [
        "files"
      ]
    }
  }
}
