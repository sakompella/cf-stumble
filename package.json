{
  "name": "cf-stumble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest run",
    "test:tools": "node --import tsx --test 'tools/**/*.test.ts'",
    "test:watch": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/page/client && tsc --noEmit -p test/page/client",
    "typecheck:tools": "tsc --noEmit -p tools",
    "lint": "oxlint --type-aware --max-warnings=0 --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:pi": "pnpm --filter @cf-stumble/pi build",
    "build:artifact": "pnpm install --frozen-lockfile --reporter=silent --ignore-scripts && pnpm run build:pi && pnpm run build:module-map",
    "build:module-map": "pnpm exec tsx tools/build-generation-0.mts",
    "build:page": "pnpm exec tsx tools/build-owner-page.mts",
    "build:loaded-execution-env-fixture": "pnpm exec tsx tools/build-loaded-execution-env-fixture.mts",
    "verify:project-protocol": "pnpm exec tsx tools/verify-project-protocol.mts",
    "local:access-session": "pnpm exec tsx tools/access-session.mts",
    "verify:vendor": "pnpm exec tsx tools/vendor-pi.mts --check",
    "probe:clean-build": "scripts/probe/clean-build.sh",
    "ops:check": "pnpm exec tsx tools/ops-check/run.mts --worker cf-stumble --since 2h",
    "harness:browser": "pnpm build:page && pnpm exec tsx tools/browser-harness/run.mts",
    "test:browser": "pnpm build:page && playwright test -c tools/playwright/playwright.config.mts",
    "verify": "pnpm build:pi && pnpm verify:vendor && pnpm verify:project-protocol && pnpm build:page && pnpm typecheck && pnpm typecheck:tools && pnpm format:check && pnpm lint && pnpm test:tools && pnpm build:module-map && pnpm build:loaded-execution-env-fixture && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@cloudflare/computer": "file:vendor/cloudflare-computer-0.3.0.tgz",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cf-stumble/pi": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5",
    "@effect/platform-browser": "4.0.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@hegeldev/hegel": "0.4.5",
    "@oxlint/plugins": "^1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "cf": "1.0.0-beta.14",
    "esbuild": "0.28.1",
    "foldkit": "0.168.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1",
    "oxlint-tsgolint": "^7",
    "tsx": "4.22.1",
    "typescript": "^7",
    "vitest": "^4",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@11.18.0"
}
