import { createHash } from "node:crypto";
import { writeFile } from "node:fs/promises";
import { resolve } from "node:path";
import { transform } from "esbuild";
import { OWNER_PAGE_SCRIPT } from "../src/page/script.ts";

/**
 * Build the owner page's script into the module the Worker serves it from.
 *
 * The script is a separate same-origin file whose path carries a hash of its bytes, so the Worker
 * can let the browser cache it for a year: a changed script is a new path, and the `no-store` page
 * always names the current one. See ADR-0046.
 *
 * Today the input is the hand-written script in `src/page/script*.ts`, and esbuild only parses and
 * prints it, so a syntax error fails the build and the delivered text stays readable. The Foldkit
 * page replaces that input with a bundled entry module.
 *
 * Git ignores the output. `pnpm verify`, the browser harness, and the Wrangler build command that
 * `cf build` and `cf deploy` run all call this first, so a deployed script cannot be older than
 * its source.
 */

const repoRoot = resolve(import.meta.dirname, "..");

const OUTPUT_PATH = "src/page/owner-script.generated.ts";

// 16 hex digits are 64 bits, far more than a few releases of one script can collide in.
const HASH_LENGTH = 16;

const built = await transform(OWNER_PAGE_SCRIPT, {
  loader: "js",
  target: "es2022",
  legalComments: "none",
  sourcefile: "owner-page.js",
});

const hash = createHash("sha256").update(built.code).digest("hex").slice(0, HASH_LENGTH);

const scriptPath = `/assets/owner-${hash}.js`;

await writeFile(
  resolve(repoRoot, OUTPUT_PATH),
  `// Generated by tools/build-owner-page.mts. Do not edit.\n` +
    `export const OWNER_PAGE_SCRIPT_PATH = ${JSON.stringify(scriptPath)};\n` +
    `export const OWNER_PAGE_SCRIPT_SOURCE = ${JSON.stringify(built.code)};\n`,
);

console.log(`Wrote ${OUTPUT_PATH}: ${scriptPath}, ${built.code.length} bytes`);
