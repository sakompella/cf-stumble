{
  // Node-side code: the git codec, storage, generations, pointer, replay, and their tests.
  // Worker-side code lives in tsconfig.workers.json under a different global environment.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src", "test", "*.config.ts"],
  "exclude": ["src/supervisor", "src/agent", "test/facet"]
}
