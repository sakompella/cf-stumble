{
  // One program. The Node-side/worker-side split existed because @cloudflare/workers-types is a
  // global augmentation that replaces Node's lib globals, and some tests needed node: builtins.
  // Nothing imports node: any more, so there is one environment: workerd.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "test", "*.config.ts"]
}
